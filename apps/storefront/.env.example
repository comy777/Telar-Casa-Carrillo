# Origen público de la API (el navegador la llama directamente, con cookies).
# En producción debe ser un subdominio del mismo sitio: https://api.<dominio>
NEXT_PUBLIC_API_URL=http://localhost:3001

# Origen que usa el servidor de Next para leer el catálogo (puede ser una red interna).
API_URL_INTERNAL=http://localhost:3001

# URL pública de la tienda (metadatos, sitemap, enlaces canónicos).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secreto compartido con el backend para revalidar páginas al publicar cambios (POST /api/revalidate).
REVALIDATE_SECRET=change_me

# Pon "true" para desactivar el checkout (mantenimiento). La tienda sigue visible.
NEXT_PUBLIC_CHECKOUT_DISABLED=false
